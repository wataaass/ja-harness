{
  "name": "ja-harness",
  "version": "0.0.1",
  "description": "日本語で安く使えるコードのエージェントの実行環境",
  "type": "module",
  "author": "wataaass",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ja-harness": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
